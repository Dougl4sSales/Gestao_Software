
@page "/"
@page "/softwares"

@using System
@using System.Linq
@using System.Collections.Generic
@using GestaoDeSofware.Frontend.DTOs
@using GestaoDeSofware.Frontend.Services
@using Microsoft.AspNetCore.Components

@inject SoftwareApiService SoftwareApi

<PageTitle>Gestão de Software</PageTitle>

<div class="software-page">

    <header class="page-header">
        <div class="page-header-content">
            <div class="page-icon">
                <i class="bi bi-boxes"></i>
            </div>

            <div>
                <h1>Gestão de Software</h1>
                <p>Gerencie seus softwares e acompanhe suas versões.</p>
            </div>
        </div>

        <NavLink href="/softwares/novo"
                 class="btn-primary-custom">
            <i class="bi bi-plus-lg"></i>
            Novo software
        </NavLink>
    </header>

    @if (Carregando)
    {
        <div class="state-message">
            <div class="loading-spinner"></div>
            <p>Carregando softwares...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Erro))
    {
        <div class="error-message">
            <i class="bi bi-exclamation-triangle"></i>
            <span>@Erro</span>

            <button type="button"
                    class="btn-secondary-custom"
                    @onclick="CarregarAsync">
                Tentar novamente
            </button>
        </div>
    }
    else
    {
        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon stat-icon-blue">
                    <i class="bi bi-box"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Softwares cadastrados</span>
                    <strong>@ListaSoftwares.Count</strong>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon stat-icon-purple">
                    <i class="bi bi-collection"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Total de versões</span>
                    <strong>@TotalVersoes</strong>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon stat-icon-orange">
                    <i class="bi bi-archive"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Versões depreciadas</span>
                    <strong>@TotalDepreciadas</strong>
                </div>
            </div>
        </section>

        <section class="software-content">
            <div class="content-toolbar">
                <div class="toolbar-title">
                    <h2>Seus softwares</h2>
                    <span class="results-count">
                        @SoftwaresFiltrados.Count
                        @(SoftwaresFiltrados.Count == 1
                            ? "resultado"
                            : "resultados")
                    </span>
                </div>               
            </div>

            @if (SoftwaresFiltrados.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    @if (ListaSoftwares.Count == 0)
                    {
                        <h3>Nenhum software cadastrado</h3>
                        <p>Comece cadastrando seu primeiro software.</p>

                        <NavLink href="/softwares/novo"
                                 class="btn-primary-custom">
                            <i class="bi bi-plus-lg"></i>
                            Cadastrar software
                        </NavLink>
                    }
                    else
                    {
                        <h3>Nenhum resultado encontrado</h3>
                        <p>Tente pesquisar usando outro nome ou número de versão.</p>

                        <button type="button"
                                class="btn-secondary-custom"
                                @onclick="LimparBusca">
                            Limpar pesquisa
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="software-list">
                    @foreach (var software in SoftwaresFiltrados)
                    {
                        var versoes = software.Versoes
                            ?? new List<VersaoSoftwareDto>();

                        <article class="software-card" @key="software.Id">

                            <div class="software-card-header">
                                <div class="software-card-toggle">
                                    <div class="software-card-icon">
                                        <i class="bi bi-box-seam"></i>
                                    </div>

                                    <div class="software-card-info">
                                        <h3>@software.Nome</h3>

                                        <p class="software-description">
                                            @(string.IsNullOrWhiteSpace(software.Descricao)
                                                ? "Nenhuma descrição informada."
                                                : software.Descricao)
                                        </p>

                                        <div class="software-card-meta">
                                            <span class="meta-badge">
                                                <i class="bi bi-layers"></i>
                                                @versoes.Count
                                                @(versoes.Count == 1
                                                    ? "versão"
                                                    : "versões")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="software-card-actions">
                                    <NavLink href="@($"/softwares/{software.Id}/versoes/nova")"
                                             class="btn-version">
                                        <i class="bi bi-plus-lg"></i>
                                        <span>Nova versão</span>
                                    </NavLink>
                                </div>
                            </div>

                            <div class="software-card-body">
                                <div class="versions-heading">
                                    <div>
                                        <h4>Versões cadastradas</h4>
                                        <p>Histórico de releases deste software.</p>
                                    </div>
                                </div>

                                @if (versoes.Count == 0)
                                {
                                    <div class="versions-empty">
                                        <i class="bi bi-inbox"></i>
                                        <span>
                                            Nenhuma versão cadastrada para este software.
                                        </span>

                                        <NavLink href="@($"/softwares/{software.Id}/versoes/nova")"
                                                 class="btn-version">
                                            <i class="bi bi-plus-lg"></i>
                                            Cadastrar primeira versão
                                        </NavLink>
                                    </div>
                                }
                                else
                                {
                                    <div class="versions-list">
                                        @foreach (var versao in versoes.OrderByDescending(v => v.DataRelease))
                                        {
                                            <div class="version-item" @key="versao.Id">
                                                <div class="version-icon">
                                                    <i class="bi bi-tag"></i>
                                                </div>

                                                <div class="version-info">
                                                    <strong>
                                                        Versão @versao.NumeroVersao
                                                    </strong>

                                                    <span>
                                                        <i class="bi bi-calendar3"></i>
                                                        Release:
                                                        @versao.DataRelease.ToString("dd/MM/yyyy")
                                                    </span>
                                                </div>

                                                <div class="version-status">
                                                    @if (versao.Depreciado)
                                                    {
                                                        <span class="status-badge status-deprecated">
                                                            <i class="bi bi-exclamation-circle"></i>
                                                            Depreciada
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status-badge status-active">
                                                            <i class="bi bi-check-circle"></i>
                                                            Ativa
                                                        </span>
                                                    }
                                                </div>

                                                <div class="version-actions">
                                                    <NavLink href="@($"/softwares/{software.Id}/versoes/{versao.Id}/editar")"
                                                             class="btn btn-sm btn-outline-secondary">
                                                        <i class="bi bi-pencil"></i>
                                                        Editar
                                                    </NavLink>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private List<SoftwareDto> ListaSoftwares = new();

    private string Busca { get; set; } = string.Empty;
    private bool Carregando { get; set; } = true;
    private string? Erro { get; set; }

    private List<SoftwareDto> SoftwaresFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Busca))
                return ListaSoftwares;

            var termo = Busca.Trim();

            return ListaSoftwares
                .Where(software =>
                    (software.Nome?.Contains(
                        termo, StringComparison.OrdinalIgnoreCase) ?? false)
                    ||
                    (software.Descricao?.Contains(
                        termo, StringComparison.OrdinalIgnoreCase) ?? false)
                    ||
                    (software.Versoes?.Any(versao =>
                        versao.NumeroVersao?.Contains(
                            termo, StringComparison.OrdinalIgnoreCase) ?? false) ?? false))
                .ToList();
        }
    }

    private int TotalVersoes =>
        ListaSoftwares.Sum(s => s.Versoes?.Count ?? 0);

    private int TotalDepreciadas =>
        ListaSoftwares.Sum(s =>
            s.Versoes?.Count(v => v.Depreciado) ?? 0);

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        Carregando = true;
        Erro = null;

        try
        {
            var resultado = await SoftwareApi.ListarAsync();
            ListaSoftwares = resultado?.ToList() ?? new List<SoftwareDto>();
        }
        catch (Exception ex)
        {
            Erro = $"Não foi possível carregar os softwares. Detalhes: {ex.Message}";
        }
        finally
        {
            Carregando = false;
        }
    }

    private void LimparBusca()
    {
        Busca = string.Empty;
    }
}
