@page "/"
@page "/softwares"

@using System
@using System.Linq
@using System.Collections.Generic
@using GestaoDeSofware.Frontend.DTOs
@using GestaoDeSofware.Frontend.Services

@inject SoftwareApiService SoftwareApi

<PageTitle>Gestão de Software</PageTitle>

<div class="software-page">

    <header class="software-header">
        <div>
            <h1>
                <i class="bi bi-boxes me-2"></i>
                Gestão de Software
            </h1>
            <p>Gerencie seus Softwares e acompanhe suas versões.</p>
        </div>

        <NavLink href="/softwares/novo" class="btn-primary-custom">
            <i class="bi bi-plus-lg me-2"></i>
            Novo software
        </NavLink>
    </header>

    @if (!string.IsNullOrWhiteSpace(Mensagem))
    {
        <div class="alert alert-success alert-dismissible" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @Mensagem

            <button type="button"
                    class="btn-close"
                    aria-label="Fechar"
                    @onclick="LimparMensagem">
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Erro))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @Erro

            <button type="button"
                    class="btn btn-outline-danger btn-sm ms-2"
                    @onclick="CarregarAsync">
                Tentar novamente
            </button>
        </div>
    }

    <section class="software-stats">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-box"></i>
            </div>
            <div>
                <span class="stat-label">Softwares Cadastrados</span>
                <strong>@ListaSoftwares.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-layers"></i>
            </div>
            <div>
                <span class="stat-label">Versões Cadastradas</span>
                <strong>@TotalVersoes</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-archive"></i>
            </div>
            <div>
                <span class="stat-label">Versões Depreciadas</span>
                <strong>@TotalDepreciadas</strong>
            </div>
        </div>
    </section>

    <section class="software-content">

        <div class="software-toolbar">
            <div>
                <h2>Meus softwares</h2>
                <p>Consulte os sistemas e suas respectivas versões.</p>
            </div>

            <div class="search-box">
                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Buscar software ou versão..."
                       @bind="Busca"
                       @bind:event="oninput" />

                @if (!string.IsNullOrWhiteSpace(Busca))
                {
                    <button type="button"
                            title="Limpar busca"
                            aria-label="Limpar busca"
                            @onclick="LimparBusca">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
        </div>

        @if (Carregando)
        {
            <div class="loading-container">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
                <p>Carregando softwares...</p>
            </div>
        }
        else if (SoftwaresFiltrados.Count == 0)
        {
            <div class="empty-state">
                @if (ListaSoftwares.Count == 0)
                {
                    <i class="bi bi-inbox"></i>
                    <h3>Nenhum software cadastrado</h3>
                    <p>Cadastre seu primeiro software para começar.</p>

                    <NavLink href="/softwares/novo" class="btn-primary-custom">
                        <i class="bi bi-plus-lg me-2"></i>
                        Cadastrar software
                    </NavLink>
                }
                else
                {
                    <i class="bi bi-search"></i>
                    <h3>Nenhum resultado encontrado</h3>
                    <p>Tente pesquisar por outro nome ou número de versão.</p>

                    <button type="button"
                            class="btn-secondary-custom"
                            @onclick="LimparBusca">
                        Limpar busca
                    </button>
                }
            </div>
        }
        else
        {
            <div class="software-grid">

                @foreach (var software in SoftwaresFiltrados)
                {
                    <article class="software-card" @key="software.Id">

                        <div class="software-card-header">
                            <div class="software-card-icon">
                                <i class="bi bi-box-seam"></i>
                            </div>

                            <div class="software-card-title">
                                <h3>@software.Nome</h3>

                                @if (!string.IsNullOrWhiteSpace(software.Descricao))
                                {
                                    <p>@software.Descricao</p>
                                }
                                else
                                {
                                    <p class="text-muted">Sem descrição cadastrada.</p>
                                }
                            </div>
                        </div>

                        <div class="software-card-body">
                            <div class="versions-heading">
                                <h4>
                                    <i class="bi bi-layers me-2"></i>
                                    Versões
                                </h4>

                                <span class="version-count">
                                    @(software.Versoes?.Count ?? 0)
                                </span>
                            </div>

                            @if (software.Versoes is { Count: > 0 })
                            {
                                <div class="version-list">

                                    @foreach (var versao in software.Versoes
                                        .OrderByDescending(v => v.DataRelease))
                                    {
                                        <div class="version-row-container"
                                             @key="versao.Id">

                                            <div class="version-item">

                                                <div class="version-info">
                                                    <strong>
                                                        <i class="bi bi-tag me-1"></i>
                                                        @versao.NumeroVersao
                                                    </strong>

                                                    <small>
                                                        <i class="bi bi-calendar3 me-1"></i>
                                                        @versao.DataRelease.ToString("dd/MM/yyyy")
                                                    </small>
                                                </div>

                                                <div class="version-actions">

                                                    @if (versao.Depreciado)
                                                    {
                                                        <span class="badge bg-secondary">
                                                            Depreciada
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">
                                                            Ativa
                                                        </span>
                                                    }

                                                    <NavLink
                                                        href="@($"/softwares/{software.Id}/versoes/{versao.Id}/editar")"
                                                        class="btn-icon-action btn-edit-version"
                                                        title="Editar versão"
                                                        aria-label="@($"Editar versão {versao.NumeroVersao}")">
                                                        <i class="bi bi-pencil"></i>
                                                    </NavLink>

                                                    <button type="button"
                                                            class="btn-icon-action btn-delete-version"
                                                            title="Excluir versão"
                                                            aria-label="@($"Excluir versão {versao.NumeroVersao}")"
                                                            disabled="@(ExcluindoVersaoId.HasValue || ExcluindoId.HasValue)"
                                                            @onclick="() => SolicitarExclusaoVersao(versao.Id)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>

                                                </div>
                                            </div>

                                            @if (VersaoIdParaExcluir == versao.Id)
                                            {
                                                <div class="delete-version-confirmation">
                                                    <div class="delete-version-message">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                                        <span>
                                                            Excluir a versão
                                                            <strong>@versao.NumeroVersao</strong>?
                                                        </span>
                                                    </div>

                                                    <div class="delete-version-actions">
                                                        <button type="button"
                                                                class="btn-cancel-delete-version"
                                                                disabled="@ExcluindoVersaoId.HasValue"
                                                                @onclick="CancelarExclusaoVersao">
                                                            Cancelar
                                                        </button>

                                                        <button type="button"
                                                                class="btn-confirm-delete-version"
                                                                disabled="@(ExcluindoVersaoId.HasValue || ExcluindoId.HasValue)"
                                                                @onclick="() => ExcluirVersaoAsync(software.Id, versao.Id)">

                                                            @if (ExcluindoVersaoId == versao.Id)
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1"
                                                                      role="status"></span>
                                                                <span>Excluindo...</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-trash me-1"></i>
                                                                <span>Confirmar exclusão</span>
                                                            }
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="no-versions">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Nenhuma versão cadastrada.
                                </div>
                            }
                        </div>

                        <div class="software-card-footer">
                            <NavLink
                                href="@($"/softwares/{software.Id}/versoes/nova")"
                                class="btn-version">
                                <i class="bi bi-plus-lg me-1"></i>
                                Nova versão
                            </NavLink>

                            <button type="button"
                                    class="btn-delete-software"
                                    title="Excluir software"
                                    aria-label="@($"Excluir software {software.Nome}")"
                                    disabled="@(ExcluindoId.HasValue || ExcluindoVersaoId.HasValue)"
                                    @onclick="() => SolicitarExclusao(software.Id)">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>

                        @if (SoftwareIdParaExcluir == software.Id)
                        {
                            <div class="delete-confirmation">
                                <p>
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    Deseja excluir <strong>@software.Nome</strong>?
                                </p>

                                <small>
                                    Essa operação não poderá ser desfeita.
                                </small>

                                <div class="delete-confirmation-actions">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            disabled="@ExcluindoId.HasValue"
                                            @onclick="CancelarExclusao">
                                        Cancelar
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            disabled="@ExcluindoId.HasValue"
                                            @onclick="() => ExcluirAsync(software.Id)">
                                        @if (ExcluindoId == software.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"
                                                  role="status"></span>
                                            <span>Excluindo...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-trash me-1"></i>
                                            <span>Confirmar exclusão</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }

                    </article>
                }
            </div>

            <div class="results-footer">
                Exibindo @SoftwaresFiltrados.Count de @ListaSoftwares.Count software(s).
            </div>
        }
    </section>
</div>

@code {
    private List<SoftwareDto> ListaSoftwares = new();

    private string Busca { get; set; } = string.Empty;
    private bool Carregando { get; set; } = true;

    private string? Erro { get; set; }
    private string? Mensagem { get; set; }

    private int? SoftwareIdParaExcluir { get; set; }
    private int? ExcluindoId { get; set; }

    private int? VersaoIdParaExcluir { get; set; }
    private int? ExcluindoVersaoId { get; set; }

    private List<SoftwareDto> SoftwaresFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Busca))
                return ListaSoftwares;

            var termo = Busca.Trim();

            return ListaSoftwares
                .Where(software =>
                    (software.Nome?.Contains(
                        termo, StringComparison.OrdinalIgnoreCase) ?? false)
                    ||
                    (software.Descricao?.Contains(
                        termo, StringComparison.OrdinalIgnoreCase) ?? false)
                    ||
                    (software.Versoes?.Any(versao =>
                        versao.NumeroVersao?.Contains(
                            termo, StringComparison.OrdinalIgnoreCase) ?? false) ?? false))
                .ToList();
        }
    }

    private int TotalVersoes =>
        ListaSoftwares.Sum(s => s.Versoes?.Count ?? 0);

    private int TotalDepreciadas =>
        ListaSoftwares.Sum(s =>
            s.Versoes?.Count(v => v.Depreciado) ?? 0);

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        Carregando = true;
        Erro = null;

        try
        {
            var resultado = await SoftwareApi.ListarAsync();
            ListaSoftwares = resultado?.ToList() ?? new List<SoftwareDto>();
        }
        catch (Exception ex)
        {
            Erro = $"Não foi possível carregar os softwares: {ex.Message}";
        }
        finally
        {
            Carregando = false;
        }
    }

    private void SolicitarExclusao(int softwareId)
    {
        Erro = null;
        Mensagem = null;

        VersaoIdParaExcluir = null;
        SoftwareIdParaExcluir = softwareId;
    }

    private void CancelarExclusao()
    {
        if (!ExcluindoId.HasValue)
            SoftwareIdParaExcluir = null;
    }

    private async Task ExcluirAsync(int softwareId)
    {
        if (ExcluindoId.HasValue || ExcluindoVersaoId.HasValue)
            return;

        ExcluindoId = softwareId;
        Erro = null;
        Mensagem = null;

        try
        {
            await SoftwareApi.ExcluirAsync(softwareId);

            ListaSoftwares.RemoveAll(s => s.Id == softwareId);
            SoftwareIdParaExcluir = null;

            Mensagem = "Software excluído com sucesso.";
        }
        catch (Exception ex)
        {
            Erro = $"Não foi possível excluir o software: {ex.Message}";
        }
        finally
        {
            ExcluindoId = null;
        }
    }

    private void SolicitarExclusaoVersao(int versaoId)
    {
        Erro = null;
        Mensagem = null;

        SoftwareIdParaExcluir = null;
        VersaoIdParaExcluir = versaoId;
    }

    private void CancelarExclusaoVersao()
    {
        if (!ExcluindoVersaoId.HasValue)
            VersaoIdParaExcluir = null;
    }

    private async Task ExcluirVersaoAsync(int softwareId, int versaoId)
    {
        if (ExcluindoVersaoId.HasValue || ExcluindoId.HasValue)
            return;

        ExcluindoVersaoId = versaoId;
        Erro = null;
        Mensagem = null;

        try
        {
            await SoftwareApi.ExcluirVersaoAsync(versaoId);

            var software = ListaSoftwares
                .FirstOrDefault(s => s.Id == softwareId);

            software?.Versoes.RemoveAll(v => v.Id == versaoId);

            VersaoIdParaExcluir = null;
            Mensagem = "Versão excluída com sucesso.";
        }
        catch (Exception ex)
        {
            Erro = $"Não foi possível excluir a versão: {ex.Message}";
        }
        finally
        {
            ExcluindoVersaoId = null;
        }
    }

    private void LimparBusca()
    {
        Busca = string.Empty;
    }

    private void LimparMensagem()
    {
        Mensagem = null;
    }
}